# Required: Neon PostgreSQL (pooled connection string)
DATABASE_URL=

# Public canonical site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Persistent uploads: Vercel Blob read/write token
BLOB_READ_WRITE_TOKEN=

# Optional Razorpay integration (all three required for online payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# Optional Resend email integration
RESEND_API_KEY=
EMAIL_FROM=

# Optional WhatsApp Cloud API integration
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional approved template with one body variable for business-initiated updates
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Optional Twilio SMS integration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Comma-separated login emails that may be promoted to admin by the seed script
ADMIN_EMAILS=
