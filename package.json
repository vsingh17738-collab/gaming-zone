{
  "name": "shri-shaam-tent-house",
  "version": "1.0.0",
  "private": true,
  "description": "Production website and booking platform for Shri Shaam Tent House, Pithampur.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
